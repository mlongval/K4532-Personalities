#!/bin/sh
# Start one Amiga personality: run/<name> is a link to this file.  The image
# (mounted at /opt/personalities/amiga, a RAM copy) carries Amiberry and the
# Kickstarts; everything else is the user's and lives on the disk (p4), in
# ~/personalities/<name>:
#   <name>.uae  the configuration (written on the first start; F12 -> Save
#               config, or edit it)
#   floppies/   ADFs: the Workbench disks, games -- F12 -> Floppy drives
#   DH0/        the A1200's hard drive, a directory with Workbench 3.1 on it
#   Work.hdf    DH1:, Work, a 20 MB hardfile (FFS)
#   Games/      DH2:, Games, if there: a directory of WHDLoad games
#   DH0/S/Desktop-Scalos  there: Scalos is the desktop, not Workbench 3.1
#               (the sidebar's F11 makes and removes it)
A=/opt/personalities/amiga
name=$(basename "$0")
# The placement every personality shares: ~/personalities/display.cfg,
# placement=left|centre, scale=fit|integer, sidebar=NAME (the X16's F12
# menu writes it).
C=$HOME/personalities/display.cfg
if [ -f "$C" ]; then
    v=$(sed -n 's/^placement=//p' "$C"); [ -n "$v" ] && export K4510_PLACEMENT=${K4510_PLACEMENT:-$v}
    v=$(sed -n 's/^scale=//p' "$C"); [ -n "$v" ] && export K4510_SCALE=${K4510_SCALE:-$v}
    v=$(sed -n 's/^sidebar=//p' "$C"); [ -n "$v" ] && [ -z "$K4510_SIDEBAR" ] && export K4510_SIDEBAR="$v state=$HOME/personalities/sidebar"
fi
# The K4510's sidebar scenes (its layer builds the library); sidebar=NAME in
# display.cfg picks one: antfarm matrix space river dreamfall tetris
# halloween christmas, or none.
# the K4532's scenes (its library; ~/k4510/sdl/libk4510side.so before the names pass, 2026-10-12)
for l in "$HOME/k4532/sdl/libk4532side.so" "$HOME/k4510/sdl/libk4510side.so"; do
    [ -z "$K4510_SIDEBAR_LIB" ] && [ -f "$l" ] && export K4510_SIDEBAR_LIB=$l
done
mkdir -p "$HOME/personalities/sidebar"
export LD_LIBRARY_PATH=$A/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
D=$HOME/personalities/$name; mkdir -p "$D/floppies"; cd "$D" || exit 1
[ -f "$D/$name.uae" ] || sed "s|@HOME@|$D|g; s|@IMG@|$A|g" "$A/conf/$name.uae" > "$D/$name.uae"
# DH1:, Work, 20 MB (tools/make-amiga-hd.sh), into a configuration written
# before it existed -- once (.added-dh1): taken out later, it stays out
if [ -f "$D/Work.hdf" ] && [ ! -f "$D/.added-dh1" ]; then
    grep -q "^hardfile2=.*DH1:" "$D/$name.uae" || echo "hardfile2=rw,DH1:$D/Work.hdf,32,1,2,512,-128,,uae1" >> "$D/$name.uae"
    touch "$D/.added-dh1"
fi
# A hardfile2 line that stops after the boot priority ("...,512,-128,", as
# written here until 2026-10-18) is cut short in Amiberry's parser before it
# is marked a hardfile, so the drive is mounted as a FOLDER at the .hdf's
# path: write-protected, 1257 MB, and Guru 8000 0005 (divide by zero) when
# Workbench opens it (Doc, 2026-10-18).  The filesystem field (empty: the
# ROM's FFS) and the controller (uae1) complete it -- the form Amiberry
# itself writes.
sed -i -E 's/^(hardfile2=r[ow],DH[0-9]+:[^,]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+,-?[0-9]+),$/\1,,uae1/' "$D/$name.uae"
# RTG (Doc, 2026-10-17): Picasso96 for uaegfx onto DH0 once (the image's p96,
# tools/get-picasso96.sh), and the graphics card into a configuration written
# before it -- once (.added-rtg): turned off later (Amiberry's Save config
# then writes no gfxcard_size; the hub's form takes the line out), it stays off
if [ "$name" = a1200 ] && [ -d "$A/p96" ] && [ -d "$D/DH0" ] && [ ! -f "$D/DH0/Libs/Picasso96/rtg.library" ]; then
    cp -r "$A/p96/Libs" "$A/p96/Devs" "$A/p96/Prefs" "$D/DH0/" && chmod -R u+w "$D/DH0/Libs" "$D/DH0/Devs" "$D/DH0/Prefs"
fi
if [ "$name" = a1200 ] && [ ! -f "$D/.added-rtg" ]; then
    if ! grep -q "^gfxcard_size=" "$D/$name.uae"; then
        sed -i '/^cpu_type=/d; /^cpu_24bit_addressing=/d; /^gfxcard_type=/d' "$D/$name.uae"
        printf 'cpu_type=68020\ncpu_24bit_addressing=false\ngfxcard_type=ZorroIII\ngfxcard_size=16\n' >> "$D/$name.uae"
    fi
    touch "$D/.added-rtg"
fi
# Scalos and icon.library 51 (Doc, 2026-10-18: "Can you install Scalos?"):
# the image's DH0 tree ($A/dh0, tools/install-scalos.sh) onto DH0 once
# (.added-scalos), files already there kept; and the Startup-Sequence taught
# to take icon.library from Libs: (RemLib before SetPatch, or Workbench 3.1's
# ROM one draws NewIcons as blank boxes) and to start Scalos instead of
# Workbench while S:Desktop-Scalos is there -- the sidebar's Desktop, F11.
if [ "$name" = a1200 ] && [ -d "$A/dh0" ] && [ -d "$D/DH0" ] && [ ! -f "$D/.added-scalos" ]; then
    cp -rn "$A/dh0/." "$D/DH0/" && chmod -R u+w "$D/DH0"
    F=$D/DH0/S/Startup-Sequence
    [ -f "$F.before-scalos" ] || cp -p "$F" "$F.before-scalos"
    grep -q 'RemLib >NIL: icon.library' "$F" || sed -i 's|^C:SetPatch QUIET$|; icon.library 51 (PeterK, from Libs:) in place of the ROM 40.1, for the NewIcons and\n; ColorIcons of the Games drive (K4532, 2026-10-18)\nIf EXISTS LIBS:icon.library\n  C:RemLib >NIL: icon.library\nEndIf\nC:SetPatch QUIET|' "$F"
    grep -q 'Desktop-Scalos' "$F" || sed -i 's|^C:LoadWB$|; the desktop (K4532, 2026-10-18): Scalos when S:Desktop-Scalos is there\n; (the A1200 sidebar'"'"'s Desktop, F11), Workbench 3.1'"'"'s own otherwise\nIF EXISTS S:Desktop-Scalos\n  IF EXISTS C:LoadWB.scalos\n    C:Assign >NIL: Scalos: SYS:Scalos\n    C:LoadWB.scalos\n  Else\n    C:LoadWB\n  EndIF\nElse\n  C:LoadWB\nEndIF|' "$F"
    touch "$D/.added-scalos"
fi
# MUI 3.8 (Doc, 2026-10-18: "add mui"), for Scalos's Prefs and windows:
# SYS:MUI from the same tree once (.added-mui), and the lines its installer
# adds to S:User-Startup (MUI: assigned, its Libs and Locale added).
if [ "$name" = a1200 ] && [ -d "$A/dh0/MUI" ] && [ -d "$D/DH0" ] && [ ! -f "$D/.added-mui" ]; then
    [ -d "$D/DH0/MUI" ] || { cp -r "$A/dh0/MUI" "$D/DH0/" && cp -n "$A/dh0/MUI.info" "$D/DH0/" 2>/dev/null; chmod -R u+w "$D/DH0/MUI"; }
    U=$D/DH0/S/User-Startup
    grep -q "BEGIN MUI" "$U" 2>/dev/null || printf '%s\n' ';BEGIN MUI' 'if exists "SYS:MUI"' '   assign MUI: "SYS:MUI"' \
        '   if exists MUI:Libs' '      assign add LIBS: MUI:Libs' '   endif' '   if exists MUI:Locale' '      assign add LOCALE: MUI:Locale' \
        '   endif' '   version >nil: exec.library 39' '   if not warn' '      if exists MUI:Docs' '         if exists HELP:dummy ; do not remove' \
        '         endif                ; this entry!' '         assign add HELP: MUI:Docs' '      endif' '   endif' 'endif' ';END MUI' >> "$U"
    touch "$D/.added-mui"
fi
# the sidebar's Desktop box and its F11, where the Startup-Sequence chooses
[ "$name" = a1200 ] && [ -f "$D/DH0/C/LoadWB.scalos" ] && grep -q 'Desktop-Scalos' "$D/DH0/S/Startup-Sequence" 2>/dev/null \
    && export K4510_AMIGA_DESKTOP=$D/DH0/S/Desktop-Scalos
# Auto-crop (Doc, 2026-10-18: "an empty grey border around it"): the picture
# is cut to what the Amiga actually shows -- Workbench's 640x512, not the
# 720x568 of overscan around it in the screen's colour 0 -- and that is what
# fills the full height at the left.  Into every configuration once
# (.added-crop): turned off later, it stays off.
if [ ! -f "$D/.added-crop" ]; then
    grep -q "^amiberry.gfx_auto_crop=" "$D/$name.uae" || echo "amiberry.gfx_auto_crop=true" >> "$D/$name.uae"
    touch "$D/.added-crop"
fi
# DH2:, Games (Doc, 2026-10-18): a folder of WHDLoad games (Pimiga 4's
# Games/WHDLOAD, the drive's root its AGA, OCS, CD32 ... drawers), mounted
# as a directory; WHDLoad itself in DH0:C and its Kickstarts in
# DH0:Devs/Kickstarts.  With it 64 MB of Zorro III fast RAM, for WHDLoad's
# PRELOAD of the bigger games.  Into the configuration once (.added-dh2):
# taken out later, it stays out.
if [ -d "$D/Games" ] && [ ! -f "$D/.added-dh2" ]; then
    grep -q "^filesystem2=.*DH2:" "$D/$name.uae" || echo "filesystem2=rw,DH2:Games:$D/Games,-128" >> "$D/$name.uae"
    grep -q "^z3mem_size=" "$D/$name.uae" || echo "z3mem_size=64" >> "$D/$name.uae"
    touch "$D/.added-dh2"
fi
# The sidebar: the A1200's own, lettered in Topaz from the Kickstart
# (K4510_AMIGA_PANEL=0: the K4532 scene); the touchpad as the mouse, by
# Amiberry's finger code (touchpad.py), not SDL's own mouse made of fingers.
export K4510_TOPAZ=$A/topaz.bin SDL_TOUCH_MOUSE_EVENTS=0
# Amiberry's own files (amiberry.conf, logs, savestates) beside the rest
export XDG_CONFIG_HOME=$D/.config XDG_DATA_HOME=$D/.local
exec $A/bin/amiberry --config "$D/$name.uae" -G "$@"
