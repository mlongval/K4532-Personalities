#!/bin/sh
# Start one VICE personality: run/<name> is a link to this file.
# Runs from the image k4510-personality mounted at /opt/personalities/vice.
# Saved things live in ~/personalities/<name> (the disk, p4); VICE's own
# settings in ~/.config/vice/vicerc (F12 -> Settings -> Save).
V=/opt/personalities/vice
name=${K4510_VICE_NAME:-$(basename "$0")}
# The C64 and the C128 as one personality (Doc, 2026-10-20: the C128 out of
# the Chooser): the sidebar's MODEL row has the other machine, which writes
# its name in ~/personalities/switch and quits; this starts that one, and
# so on, until a machine quits without it.
if [ -z "$K4510_VICE_NAME" ]; then
    S=$HOME/personalities/switch; rm -f "$S"
    exec 3<&0
    trap 'kill $pid 2>/dev/null; rm -f "$S"' TERM INT HUP   # stopped from outside: the machine too
    while :; do
        K4510_VICE_NAME=$name "$V/run/vice" "$@" <&3 3<&- & pid=$!   # the terminal, not /dev/null: SDL's console keyboard
        wait $pid; rc=$?
        kill -0 $pid 2>/dev/null && { wait $pid; rc=$?; }     # (a signal ended the first wait)
        [ -f "$S" ] || exit $rc
        next=$(cat "$S"); rm -f "$S"
        case "$next" in c64|c128) name=$next ;; *) exit $rc ;; esac
    done
fi
# The placement every personality shares: ~/personalities/display.cfg,
# placement=left|centre, scale=fit|integer, sidebar=NAME (the X16's F12
# menu writes it), vdcborders=on|off (the C128's), petborders=on|off (the
# PET's: off, cropped to its text area, unless on -- Doc, 2026-10-18).
C=$HOME/personalities/display.cfg
if [ -f "$C" ]; then
    v=$(sed -n 's/^placement=//p' "$C"); [ -n "$v" ] && export K4510_PLACEMENT=${K4510_PLACEMENT:-$v}
    v=$(sed -n 's/^scale=//p' "$C"); [ -n "$v" ] && export K4510_SCALE=${K4510_SCALE:-$v}
    v=$(sed -n 's/^sidebar=//p' "$C"); [ -n "$v" ] && [ -z "$K4510_SIDEBAR" ] && export K4510_SIDEBAR="$v state=$HOME/personalities/sidebar"
    v=$(sed -n 's/^vdcborders=//p' "$C"); [ -n "$v" ] && export K4510_VDC_BORDERS=${K4510_VDC_BORDERS:-$v}
    v=$(sed -n 's/^petborders=//p' "$C"); [ -n "$v" ] && export K4510_PET_BORDERS=${K4510_PET_BORDERS:-$v}
fi
export K4510_DISPLAY_CFG=$C   # the C128's F12 -> Video settings -> VDC borders writes vdcborders= here
# The K4510's sidebar scenes (its layer builds the library); sidebar=NAME in
# display.cfg picks one: antfarm matrix space river dreamfall tetris
# halloween christmas, or none.
# the K4532's scenes (its library; ~/k4510/sdl/libk4510side.so before the names pass, 2026-10-12)
for l in "$HOME/k4532/sdl/libk4532side.so" "$HOME/k4510/sdl/libk4510side.so"; do
    [ -z "$K4510_SIDEBAR_LIB" ] && [ -f "$l" ] && export K4510_SIDEBAR_LIB=$l
done
mkdir -p "$HOME/personalities/sidebar"
export LD_LIBRARY_PATH=$V/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
D=$HOME/personalities/$name; mkdir -p "$D"; cd "$D" || exit 1
# Fullscreen on the KMS display, sound through ALSA (mixed by dmix like the
# K4510's), and the keyboard by symbol: a PC key types what is printed on it
# (Doc, 2026-10-17; -keymap 1 laid them out by position until then; the PET
# too since that evening).
# These defaults give way to what the machine's own section of VICE's
# settings says (F12 -> Settings -> Save, or the K4532 hub's Settings form,
# 2026-10-17): each is passed only when the section does not set it.
RC=$HOME/.config/vice/sdl-vicerc
case "$name" in c64) sec=C64SC ;; c128) sec=C128 ;; pet) sec=PET ;; *) sec=none ;; esac
saved() { [ -f "$RC" ] && sed -n "/^\[$sec\]/,/^\[/p" "$RC" | grep -q "^$1="; }
common="-sounddev alsa"
saved KeymapIndex || common="$common -keymap 0"
# The REU, 16 MB (VICE's largest; Doc asked for 64): PETSCII Robots' REU
# edition and GEOS use it, and it is harmless to the rest.
reu=; saved REU || reu="-reu"; saved REUsize || reu="$reu -reusize 16384"
# The SD volume: drive 9 is a folder, ~/personalities/SD, shared by the C64
# and the C128 -- VICE's filesystem device, which takes SD2IEC's CD commands
# -- with Dir Browser on it (DB64, DB128; the sidebar's BROWSE runs it).
SD=$HOME/personalities/SD; mkdir -p "$SD"
for f in DB64 DB128; do [ -f "$SD/$f" ] || [ ! -f "$V/share/dirbrowser/$f" ] || cp "$V/share/dirbrowser/$f" "$SD/$f"; done
export K4510_SD=$SD
sd="-drive9type 0 -busdevice9 -devicebackend9 1 -fs9 $SD"
# The model the sidebar's MODEL row chose (Doc, 2026-10-19), -model's word
# in ~/personalities/<name>/model; the PET a 4032 unless chosen.
model=$(sed -n '1{s/[^0-9a-z]//g;p}' "$D/model" 2>/dev/null)
case "$name" in
c64)  k="-kernal kernal-k4532.bin"   # the KERNAL's power-on colours: white on dark blue (make-images.sh); not the SX-64's
      [ "$model" = sx64 ] && k=
      exec $V/bin/x64sc $common ${model:+-model $model} -VICIIfull $reu $sd $k "$@" ;;
c128) exec $V/bin/x128  $common ${model:+-model $model} -VICIIfull -VDCfull $reu $sd "$@" ;;
pet)  # The screen's colours (Doc, 2026-10-18): white on dark blue unless
      # the sidebar's SCREEN buttons chose another (palette=green|amber|grey|
      # whiteblue in ~/personalities/pet/palette).  After -model, which sets
      # the 4032's own (the internal green) and so undid a palette chosen
      # in F12 -> Settings at every start.
      pal=$(sed -n 's/^palette=//p' "$D/palette" 2>/dev/null)
      case "$pal" in green|amber|grey|whiteblue) ;; *) pal=whiteblue ;; esac
      exec $V/bin/xpet  $common -model ${model:-4032} -CRTCfull -CRTCextpal -CRTCpalette $pal.vpl "$@" ;;   # 40 columns, 32K: what most PET games (PETSCII Robots) want
*)    echo "vice: no personality called $name"; exit 1 ;;
esac
